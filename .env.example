# Copy to .env and fill in. .env is gitignored and dockerignored — never commit
# it, and never bake it into an image.

# Required. Your Duke AI Gateway API key.
DUKE_API_KEY=

# Optional. Defaults to https://litellm.oit.duke.edu/v1
DUKE_BASE_URL=

# Optional. Default model preselected in the dropdown.
# Falls back to claude-sonnet-5 if unset.
MODEL_NAME=

# Optional. Port the Gradio server binds to. Defaults to 7860.
PORT=
